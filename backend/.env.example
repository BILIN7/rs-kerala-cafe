# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/food-ordering-uk

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Stripe (UK)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_MODE=sandbox

# Square
SQUARE_ACCESS_TOKEN=xxx
SQUARE_LOCATION_ID=xxx
SQUARE_ENVIRONMENT=sandbox

# GoCardless
GOCARDLESS_ACCESS_TOKEN=xxx
GOCARDLESS_ENVIRONMENT=sandbox

# Twilio (SMS)
TWILIO_ACCOUNT_SID=xxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+44xxx

# SendGrid (Email)
SENDGRID_API_KEY=xxx
FROM_EMAIL=orders@yourrestaurant.co.uk
FROM_NAME=Your Restaurant

# Cloudinary
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# Restaurant Info (UK)
RESTAURANT_NAME=Your Restaurant
RESTAURANT_PHONE=+44xxx
RESTAURANT_EMAIL=info@yourrestaurant.co.uk
RESTAURANT_ADDRESS=123 High Street, Manchester, M1 1AA
RESTAURANT_TIMEZONE=Europe/London
